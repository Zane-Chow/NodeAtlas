APP_ENV=production
HTTP_ADDRESS=0.0.0.0:8080
PUBLIC_ORIGIN=https://panel.example.com
DATABASE_URL=mysql://controlpanel:replace-me@mysql:3306/controlpanel
ADMIN_USERNAME=
ADMIN_PASSWORD=
CREDENTIAL_KEYS=1:replace-with-base64-encoded-32-byte-key
CREDENTIAL_ACTIVE_KEY_VERSION=1
BACKUP_DIRECTORY=/backups
CONSOLE_ALLOWED_PRIVATE_CIDRS=
MYSQL_DATABASE=controlpanel
MYSQL_USER=controlpanel
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password
